@model List<ManagementDashboard.Models.DepositMovement>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>Date</th>
            <th class="text-right">Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px;"><a class='mr-2' href='https://tpmsweb.threepeaks.co.za/Clients/Profile/ByRef/@item.Customer' target='_blank'><i class='fa fa-comment'></i></a></td>
                <td>@item.Customer</td>
                <td>@item.Date.ToString("dd-MM-yyyy")</td>
                <td class="text-right">@item.Value.ToString("N")</td>
            </tr>
        }
    </tbody>
</table>
