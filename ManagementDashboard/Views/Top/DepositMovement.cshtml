@model List<ManagementDashboard.Models.DepositMovement>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>Date</th>
            <th class="text-right">Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px;">
                    @Html.LinkToTPMSWeb(x=> item.Customer)
                </td>
                <td class="reference" data-reference="@item.Customer">@item.Customer</td>
                <td>@item.Date.ToSAShortDate()</td>
                <td class="text-right">@item.Value.ToString("N")</td>
            </tr>
        }
    </tbody>
</table>
