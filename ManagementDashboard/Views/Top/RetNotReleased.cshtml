
@model List<ManagementDashboard.Models.RetNotReleased>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>RBR</th>
            <th>Action Date</th>
            <th>Release Date</th>
            <th>Age</th>
            <th class="text-right">Retention Amount</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px;">@Html.LinkToTPMSWeb(x=>item.Ref)</td>
                <td class="reference" data-reference="@item.Ref">@item.Ref</td>
                <td>@item.Rbr</td>
                <td>@item.ActionDate.ToSAShortDate()</td>
                <td>@item.ReleaseDate.ToSAShortDate()</td>
                <td>@item.Age</td>
                <td class="text-right">@item.RetAmount.ToString("N")</td>
            </tr>
        }
    </tbody>
</table>