
@model List<ManagementDashboard.Models.GetTopValueCustomer>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th class="text-right">Collections</th>
            <th class="text-right">No. Records</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>


                @Html.LinkToTPMSWeb(x=> item.Customer)
                </td>
                <td class="reference" data-reference="@item.Customer">@item.Customer</td>
                <td class="text-right">@item.Collections.ToString("N")</td>
                <td class="text-right">@item.NumOfRecords</td>
            </tr>
        }
    </tbody>
</table>