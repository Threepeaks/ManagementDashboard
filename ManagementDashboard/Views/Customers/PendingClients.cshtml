@model List<ManagementDashboard.Models.PendingClients>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>Client</th>
            <th>Pending Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width: 20px;">
                    @Html.LinkToTPMSWeb(x=>item.Ref)
                </td>
                <td class="reference" data-reference="@item.Ref">
                    @item.Ref
                </td>
                <td>@item.Customer</td>
                <td>@item.PendingDate.ToSAShortDate()</td>
            </tr>
        }
    </tbody>
</table>

