@model List<ManagementDashboard.Models.HighestCustomerValue>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th class="text-right">Count</th>
            <th class="text-right">Value</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px;">
                    @Html.LinkToTPMSWeb(x=> item.Ref)
                </td>
                <td class="reference" data-reference="@item.Ref">@item.Ref</td>
                <td class="text-right">@item.Count</td>
                <td class="text-right">@item.Value.ToString("N")</td>
            </tr>
        }
    </tbody>
</table>

