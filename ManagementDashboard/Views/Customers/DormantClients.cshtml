

@model List<ManagementDashboard.Models.DormantClients>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>State</th>
            <th>PrevRun</th>
            <th>Next</th>
            <th>Span</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr >
                <td style="width:20px;"><a class='mr-2' href='https://tpmsweb.threepeaks.co.za/Clients/Profile/ByRef/@item.Ref' target='_blank'><i class='fa fa-comment'></i></a></td>
                <td class="reference" data-reference="@item.Ref" >@item.Ref</td>
                <td>@item.State</td>
                <td>@item.PrevRun.ToString("dd-MM-yyyy")</td>
                <td>@item.Next</td>
                <td>@item.Span</td>
            </tr>
        }
    </tbody>
</table>

