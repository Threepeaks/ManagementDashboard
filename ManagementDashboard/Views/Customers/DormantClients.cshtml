

@model List<ManagementDashboard.Models.DormantClients>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>State</th>
            <th>PrevRun</th>
            <th>Next</th>
            <th>Span</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr >
                <td style="width:20px;">
                    @Html.LinkToTPMSWeb(x=> item.Ref)
                </td>
                <td class="reference" data-reference="@item.Ref" >@item.Ref</td>
                <td>@item.State</td>
                <td>@item.PrevRun.ToSAShortDate()</td>
                <td>@item.Next</td>
                <td>@item.Span</td>
            </tr>
        }
    </tbody>
</table>

