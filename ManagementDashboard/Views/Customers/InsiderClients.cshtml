
@model List<ManagementDashboard.Models.InsiderClient>
@{

}



<table class="table table-striped table-sm">
    <thead>

        <tr>
            <th></th>
            <th>Reference</th>
            <th>Client</th>
            <th>Activation Date</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var client in Model.OrderBy(x => x.ClientReference))
        {
            <tr>
                <td style="width:20px;">
                @Html.LinkToTPMSWeb(x=>client.ClientReference)
                </td>
                <td>@client.ClientReference</td>
                <td>@client.CustomerName</td>
                <td>

                    @if (client.ActivationDate == DateTime.MinValue)
                    {
                        <span>NO DATE</span>
                    }
                    else
                    {
                        @client.ActivationDate.ToSAShortDate()
                    }

                </td>
            </tr>
        }
    </tbody>
</table>