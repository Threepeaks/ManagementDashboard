
@model List<ManagementDashboard.Models.InsiderClient>
@{

}



<table class="table table-striped table-sm">
    <thead>

        <tr>
            <th></th>
            <th>Reference</th>
            <th>Client</th>
            <th>Activation Date</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var client in Model.OrderBy(x => x.ClientReference))
        {
            <tr>
                <td style="width:20px;"><a class='mr-2' href='https://tpmsweb.threepeaks.co.za/Clients/Profile/ByRef/@client.ClientReference' target='_blank'><i class='fa fa-comment'></i></a></td>
                <td>@client.ClientReference</td>
                <td>@client.CustomerName</td>
                <td>

                    @if (client.ActivationDate == DateTime.MinValue)
                    {
                        <span>NO DATE</span>
                    }
                    else
                    {
                        @client.ActivationDate.ToString("dd/MM/yyyy")
                    }

                </td>
            </tr>
        }
    </tbody>
</table>