@model List<ManagementDashboard.Models.InCancelation>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Reference</th>
            <th>Client</th>
            <th>Cancel Status</th>
            <th>Pending Status</th>
            <th>Comment</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.LinkToTPMSWeb(x=>item.Ref)
                    @item.Ref
                </td>
                <td>@item.Customer</td>
                <td>@item.CancelStatus</td>
                <td>@item.PendingStatus</td>
                <td>@item.Comment</td>
            </tr>
        }
    </tbody>
</table>