@model List<ManagementDashboard.Models.CanceledClients>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Reference</th>
            <th>Client</th>
            <th>Cancel Start</th>
            <th>Cancel End</th>
            <th>Comment</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.LinkToTPMSWeb(x=> item.Ref)
                    @item.Ref
                </td>
                <td>@item.Customer</td>
                <td>@item.CancelStart.ToSAShortDate()</td>
                <td>@item.CancelEnd.ToSAShortDate()</td>
                <td>@item.Comment</td>
            </tr>
        }
    </tbody>
</table>

