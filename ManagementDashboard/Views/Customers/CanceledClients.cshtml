@model List<ManagementDashboard.Models.CanceledClients>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Reference</th>
            <th>Client</th>
            <th>Cancel Start</th>
            <th>Cancel End</th>
            <th>Comment</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a class='mr-2' href='https://tpmsweb.threepeaks.co.za/Clients/Profile/ByRef/@item.Ref' target='_blank'><i class='fa fa-comment'></i></a>
                    @item.Ref
                </td>
                <td>@item.Customer</td>
                <td>@item.CancelStart.ToString("dd-MM-yyyy")</td>
                <td>@item.CancelEnd.ToString("dd-MM-yyyy")</td>
                <td>@item.Comment</td>
            </tr>
        }
    </tbody>
</table>

