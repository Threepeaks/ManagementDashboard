@model List<ManagementDashboard.Models.ListOfPendingClient>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Reference</th>
            <th>Client</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Pending Status</th>
            <th>Service</th>
            <th>Sales Agent</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.LinkToTPMSWeb(x=>item.Ref)
                    @item.Ref
                </td>
                <td>@item.Customer</td>
                <td>@item.StartDate.ToSAShortDate()</td>
                <td>@item.EndDate.ToSAShortDate()</td>
                <td>@item.PendingStatus</td>
                <td>@item.Service</td>
                <td>@item.SalesAgent</td>
            </tr>
        }
    </tbody>
</table>
