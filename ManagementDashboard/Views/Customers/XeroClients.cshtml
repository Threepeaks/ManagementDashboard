@model List<ManagementDashboard.Models.XeroClient>
@{ 

   var countDisconnected = Model.Count(x => x.ConnectionStatusId == 0 );
   var countConnected = Model.Count(x => x.ConnectionStatusId == 1 );
}
<div class="row">
    <div class="col-2">
        <div class="card card-success">
            <div class="card-header">
                <h2>@countConnected</h2>
                <h4>Connected</h4>
            </div>

        </div>
    </div>
    <div class="col-2">
        <div class="card card-warning">
            <div class="card-header">
                <h2>@countDisconnected</h2>
                <h4>Disconnected</h4>
            </div>

        </div>
    </div>

</div>


<table class="table table-striped table-sm">
    <thead>

    <tr>
        <th></th>
        <th>Reference</th>
        <th>Client</th>
        <th>Tenant Name</th>
        <th>Connection</th>
    </tr>
    </thead>
    <tbody>

    @foreach (var client in Model.Where(x =>x.ServiceStatus == 1)
        .OrderBy(x => x.ConnectionStatusId).ThenBy(x=>x.CustomerReference))
    {
        var connectionClass = "badge-success";
        if (client.ConnectionStatus == "Disconnected")
        {
            connectionClass = "badge-warning";
        }
        <tr>
            <td style="width:20px;"><a class='mr-2' href='https://tpmsweb.threepeaks.co.za/Clients/Profile/ByRef/@client.CustomerReference' target='_blank'><i class='fa fa-comment'></i></a></td>
            <td>@client.CustomerReference</td>
            <td>@client.CustomerName</td>
            <td>@client.TenantName</td>
            <td>
                <span class=" badge  @connectionClass">

                    @client.ConnectionStatus
                </span>
            </td>
        </tr>
    }
    </tbody>
</table>