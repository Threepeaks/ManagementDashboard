
@model List<ManagementDashboard.Models.NewClients>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>Client</th>
            <th>Start Date</th>
            <th>Subs</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px;"><a class='mr-2' href='https://tpmsweb.threepeaks.co.za/Clients/Profile/ByRef/@item.Ref' target='_blank'><i class='fa fa-comment'></i></a></td>
                <td>@item.Ref</td>
                <td>@item.Customer</td>
                <td>@item.StartDate.ToString("dd-MM-yyyy")</td>
                <td>
                    @if (item.CountSubmissions > 0)
                    {
                        <span class="badge badge-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">No</span>
                    }
                            </td>
             
            </tr>
        }
    </tbody>
</table>

