
@model List<ManagementDashboard.Models.uManageCustomers>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Ref</th>
            <th>Customer</th>
            <th>Number of Sub(s)</th>
            <th>Total Records</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width: 20px;">
                    @Html.LinkToTPMSWeb(x=>item.Ref)
                </td>
                <td class="reference" data-reference="@item.Ref">
                    @item.Ref
                </td>
                <td>@item.Customer</td>
                <td>@item.NoRuns</td>
                <td>@item.TotalRecords</td>
            </tr>
        }
    </tbody>
</table>
