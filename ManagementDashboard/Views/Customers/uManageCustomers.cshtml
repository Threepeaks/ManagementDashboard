
@model List<ManagementDashboard.Models.uManageCustomers>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Ref</th>
            <th>Customer</th>
            <th>Number of Runs</th>
            <th>Total Records</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width: 20px;">
                    <a class='mr-2' href='https://tpmsweb.threepeaks.co.za/Clients/Profile/ByRef/@item.Ref' target='_blank'><i class='fa fa-comment'></i></a>

                </td>
                <td>
                    @item.Ref
                </td>
                <td>@item.Customer</td>
                <td>@item.NoRuns</td>
                <td>@item.TotalRecords</td>
            </tr>
        }
    </tbody>
</table>
