@model List<ManagementDashboard.Models.GetTopDebitValue>

<table class="table table-striped table-sm" >
    <thead>
        <tr>
            <th></th>
        <th>Customer</th>
        <th>Debit</th>
        <th>Action Date</th>
        <th>Rrb</th>
        <th class="text-right">Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px">@Html.LinkToTPMSWeb(x=> item.CustomerRef) </td>
                <td  class="reference" data-reference="@item.CustomerRef">@item.CustomerRef</td>
                <td>@item.DebitRef</td>
                <td>@item.ActionDate.ToSAShortDate()</td>
                <td>@item.Rbr</td>
                <td class="text-right">@item.Amount.ToString("N")</td>
            </tr>
        }
    </tbody>
</table>