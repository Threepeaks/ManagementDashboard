
@model List<ManagementDashboard.Models.GetTop20Unpaids>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Customer</th>
            <th>Unpaids</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px;">@Html.LinkToTPMSWeb(x=>item.Customer)</td>
                <td  class="reference" data-reference="@item.Customer">@item.Customer</td>
                <td>@item.Unpaids</td>
                
            </tr>
        }
    </tbody>
</table>
