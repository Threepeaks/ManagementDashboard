@model List<ManagementDashboard.DTOs.Dispute>
@{
    ViewBag.Title = "Disputes Not Resolved";
}

<h2>
    @Model.FirstOrDefault().ClientReference

    <span class="ml-2">

    @Html.LinkToTPMSWeb(x=>x.FirstOrDefault().ClientReference)
    </span>
</h2>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Client Reference</th>
            <th>Debtor Reference</th>
            <th>Debtor</th>
            <th>Action Date</th>
            <th>Due Date</th>
            <th>Amount</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                @Html.LinkToTPMSWeb(x=> item.ClientReference)
                
                @item.ClientReference</td>
                <td>@item.DebtorReference</td>
                <td>@item.DebtorName</td>
                <td>@item.ActionDate.ToString("dd/MM/yyyy")</td>
                <td>@item.ResolveDueDate.ToString("dd/MM/yyyy")</td>
                <td class="text-right">@item.Amount.ToString("N")</td>
            </tr>
        }
    </tbody>
</table>

