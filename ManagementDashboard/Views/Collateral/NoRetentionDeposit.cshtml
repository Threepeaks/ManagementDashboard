<div class="card card-primary">
    <div class="card-header">
        <a href="#" id="NoRetentionDeposit"></a>
        No Collateral | EFT Debit Order
    </div>

    <div class="card-body">
        <div id="CollateralNone">
            <i class="fa fa-spinner fa-spin"></i> Loading
        </div>
    </div>
