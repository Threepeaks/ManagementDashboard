
@model List<ManagementDashboard.Models.GetTopRevenue>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th></th>
            <th>Reference</th>
            <th>Company</th>
            <th class="text-right">Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:20px">@Html.LinkToTPMSWeb(x=>item.comRef)</td>
                <td class="reference" data-reference="@item.comRef">@item.comRef</td>
                <td>@item.Company</td>
                <td class="text-right">@item.total.ToString("N")</td>
            </tr>
        }
    </tbody>
</table>

