@model List<ManagementDashboard.Models.LiabilityCurrent>
@{
    ViewBag.Title = "LiabilityCurrent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .table thead {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #fff; /* Ensure the header has a background */
    }
</style>
<table class="table table-striped table-sm table-dark" >
    <thead class="bg-gradient-dark text-white">
        <tr>
            <th>Client</th>
            <th>Status</th>
            <th>Gateway</th>
            <th>B/F</th>
            <th>Collection</th>
            <th>Unpaids</th>
            <th>Late Unpaids</th>
            <th>Retention Held</th>
            <th>Account</th>
            <th>Balance</th>
            <th>Debit</th>
            <th>Credit</th>
            <th>Deposit Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isCancelled = item.IsCancelled ? "text-danger" : "";
            var isInCancellationClass = item.InCancellationProcess ? "text-warning text-bold" : "";
            <tr class="@isCancelled @isInCancellationClass">
                <td>
                    <div>
                        @Html.LinkToTPMSWeb(x => item.ClientReference)
                        @item.ClientReference
                    </div>
                    <div class="text-sm text-muted">@item.Client</div>
                </td>
                <td>
                    <div>
                    @item.Status

                    </div>
                    @if(item.IsCancelled)
                    {
                        <div class="text-sm text-muted">
                            @item.CancelledDate.ToString("dd/MM/yyyy") <i class="fa fa-calendar-alt " title="Cancelled"></i>   
                        </div>
                        
                    }
                </td>
                <td>@item.Gateway</td>
                <td class="text-right">
                    @if (item.BalanceBroughtForward < 0)
                    {
                        <div class="bg-warning text-white">
                            @item.BalanceBroughtForward.ToString("N")
                        </div>
                    }
                    else
                    {
                        @item.BalanceBroughtForward.ToString("N")
                    }
                </td>
                <td class="text-right">@item.Collection.ToString("N")</td>
                <td class="text-right">@item.Unpaids.ToString("N")</td>
                <td class="text-right">@item.LateUnpaids.ToString("N")</td>
                <td class="text-right">@item.RetentionHeld.ToString("N")</td>
                <td class="text-right">@item.Account.ToString("N")</td>
                <td class="text-right">
                    @if (@item.Balance != 0 && item.IsCancelled)
                    {
                        <div class="bg-danger text-white">
                            @item.Balance.ToString("N")
                        </div>
                    }
                    else if (@item.Balance < 0 && !item.IsCancelled)
                    {
                        <div class="bg-warning text-white">
                            @item.Balance.ToString("N")
                        </div>

                    }
                    else
                    {
                        @item.Balance.ToString("N")
                    }
                </td>
                <td class="text-right">@item.Debit.ToString("N")</td>
                <td class="text-right">@item.Credit.ToString("N")</td>
                <td class="text-right">

                    @if (item.DepositAmount > 0 && item.IsCancelled)
                    {
                        <div class="bg-danger text-white">
                            @item.DepositAmount.ToString("N")
                        </div>
                    }
                    else
                    {
                        @item.DepositAmount.ToString("N")
                    }


                </td>
            </tr>
        }
    </tbody>
</table>
